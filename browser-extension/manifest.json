{
  "manifest_version": 3,
  "name": "Myntra Session Sync",
  "version": "1.0",
  "description": "Reads your already-logged-in Myntra M-Direct session and sends it to the order-alert app automatically, so nobody has to paste one by hand.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["*://*.myntrainfo.com/*", "*://myntrainfo.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Myntra Session Sync"
  },
  "options_page": "options.html"
}
